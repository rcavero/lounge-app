# =============================================================================
# THE LOUNGE BEERHOUSE — Variables de entorno
# Copia este archivo como .env (dev) o .env.testing (testing) y rellena los valores.
# NUNCA subas .env ni .env.testing al repositorio.
# =============================================================================

# -----------------------------------------------------------------------------
# BASE DE DATOS
# -----------------------------------------------------------------------------

# Dev (rama dev) — SQLite local
# DATABASE_URL="file:./prisma/dev.db"

# Testing / Producción (ramas testing y main) — Supabase PostgreSQL
# Pooler (puerto 6543) — usado por la app en Vercel y en local para queries
DATABASE_URL="postgresql://postgres.XXXX:[PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Directo (puerto 5432) — solo para migraciones de Prisma (prisma migrate)
DIRECT_URL="postgresql://postgres.XXXX:[PASSWORD]@db.XXXX.supabase.co:5432/postgres"

# -----------------------------------------------------------------------------
# AUTENTICACIÓN (iron-session)
# Genera un valor aleatorio seguro: openssl rand -hex 32
# -----------------------------------------------------------------------------
AUTH_SECRET=""

# -----------------------------------------------------------------------------
# CRON JOBS
# Debe coincidir con el header Authorization que envía Vercel en vercel.json.
# Usa un valor distinto en producción y en testing.
# -----------------------------------------------------------------------------
CRON_SECRET=""

# -----------------------------------------------------------------------------
# FOOTBALL DATA API
# Obtén tu clave en https://www.football-data.org/client/register
# El plan gratuito cubre las 12 competiciones configuradas en el proyecto.
# -----------------------------------------------------------------------------
FOOTBALL_DATA_API_KEY=""

# -----------------------------------------------------------------------------
# URL BASE
# En Vercel no es necesaria (se usa VERCEL_URL automáticamente si no se define).
# En local es necesaria para que Redsys pueda redirigir a las páginas de OK/KO.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# REDSYS — PASARELA DE PAGO
#
# ENTORNO (REDSYS_ENV):
#   - No definida o cualquier valor distinto de "production" → sandbox (pruebas)
#   - "production" → producción real (requiere contrato con banco adquirente)
#
# SANDBOX (pruebas — credenciales públicas de Redsys, sin contrato):
#   REDSYS_ENV=          (dejar vacío o no definir)
#   REDSYS_MERCHANT_CODE="999008881"
#   REDSYS_TERMINAL="001"
#   REDSYS_SECRET_KEY="sq7HjrUOBfKmC576ILgskD5srU870gJ7"
#
# PRODUCCIÓN REAL (cuando el bar tenga contrato con su banco adquirente):
#   El banco/Redsys proporcionará:
#     - Número de comercio (MERCHANT_CODE): código de 9 dígitos único del comercio
#     - Terminal (TERMINAL): número de terminal asignado (normalmente "001")
#     - Clave secreta (SECRET_KEY): clave HMAC-SHA256 del contrato
#   Además hay que:
#     1. Cambiar REDSYS_ENV a "production" en las variables de Vercel (solo Production)
#     2. Configurar en el portal de Redsys la URL de notificación (webhook):
#        https://tu-dominio.vercel.app/api/payments/notify
#     3. Verificar que NEXT_PUBLIC_BASE_URL apunta al dominio de producción real
# -----------------------------------------------------------------------------
REDSYS_ENV=""
REDSYS_MERCHANT_CODE="999008881"
REDSYS_TERMINAL="001"
REDSYS_SECRET_KEY="sq7HjrUOBfKmC576ILgskD5srU870gJ7"
