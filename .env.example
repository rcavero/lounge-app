# =============================================================================
# THE LOUNGE BEERHOUSE — Variables de entorno
#
# Un fichero por BASE DE DATOS, y cada uno declara la suya en DB_ENV:
#
#   .env           Docker local, lounge_dev    DB_ENV=local       (npm run dev)
#   .env.test      Docker local, lounge_test   DB_ENV=test        (Vitest, Playwright)
#   .env.testing   Supabase de testing         DB_ENV=testing     (scripts :testing)
#   .env.prod      Supabase de producción      DB_ENV=production  (scripts :prod)
#
# NUNCA un ".env.production": Next lo carga solo en `next build` y `next start`,
# y un `npm start` en local arrancaría contra producción. Ver docs/entornos.md.
#
# Todos están en .gitignore. Este fichero es la única plantilla versionada, y los
# valores de abajo son los de desarrollo local.
# =============================================================================

# -----------------------------------------------------------------------------
# BASE DE DATOS
# -----------------------------------------------------------------------------
DB_ENV="local"

# Local: el Postgres de docker-compose.yml (npm run db:up). Credenciales de usar
# y tirar: la base no sale de la máquina.
DATABASE_URL="postgresql://lounge:lounge@localhost:5433/lounge_dev"
DIRECT_URL="postgresql://lounge:lounge@localhost:5433/lounge_dev"

# Supabase (testing y producción):
#   DATABASE_URL  el pooler en modo transacción, puerto 6543, con ?pgbouncer=true
#   DIRECT_URL    la conexión directa, puerto 5432; solo la usan las migraciones
# DATABASE_URL="postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.<ref>:<password>@db.<ref>.supabase.co:5432/postgres"

# -----------------------------------------------------------------------------
# AUTENTICACIÓN DEL PANEL (iron-session)
# Cifra la cookie de sesión. Mínimo 32 caracteres: openssl rand -hex 32
# Un valor distinto en cada entorno remoto.
# -----------------------------------------------------------------------------
AUTH_SECRET=""

# El primer administrador que crea `npm run db:seed` en local. Sin estas dos
# variables el seed no crea ninguno. Nunca se escribe una contraseña en el código.
# SEED_ADMIN_EMAIL="admin@example.com"
# SEED_ADMIN_PASSWORD=""

# -----------------------------------------------------------------------------
# CRON
# Lo que tienen que presentar las llamadas a /api/cron/* en la cabecera
# Authorization: Bearer <CRON_SECRET>. Vercel lo envía solo en producción.
# -----------------------------------------------------------------------------
CRON_SECRET=""

# -----------------------------------------------------------------------------
# URL BASE
# La de las vueltas de Redsys y la que se imprime en el recibo. En las previews
# de Vercel puede quedar vacía (se usa la URL de la rama); en producción tiene
# que ser el dominio real.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# REDSYS
#
# REDSYS_ENV="production" solo en producción. Vacía, se usa la pasarela de
# pruebas (sis-t.redsys.es).
#
# REDSYS_SECRET_KEY firma los pagos y verifica las notificaciones: con ella se
# podrían confirmar reservas sin pagar. La real solo existe en Vercel, scope
# Production. Para desarrollar vale el comercio genérico de pruebas de Redsys,
# cuyos datos son públicos:
#   REDSYS_MERCHANT_CODE="999008881"
#   REDSYS_TERMINAL="1"
#   REDSYS_SECRET_KEY="sq7HjrUOBfKmC576ILgskD5srU870gJ7"
# -----------------------------------------------------------------------------
REDSYS_ENV=""
REDSYS_MERCHANT_CODE="999008881"
REDSYS_TERMINAL="1"
REDSYS_SECRET_KEY="sq7HjrUOBfKmC576ILgskD5srU870gJ7"
