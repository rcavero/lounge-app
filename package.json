{
  "name": "lounge-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:testing": "dotenv -e .env.testing -- next dev",
    "dev:academic": "dotenv -e .env.academic -- next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",

    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",

    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "db:whoami": "npx tsx scripts/db-whoami.ts",

    "db:whoami:testing": "dotenv -e .env.testing -- npx tsx scripts/db-whoami.ts",
    "db:whoami:academic": "dotenv -e .env.academic -- npx tsx scripts/db-whoami.ts",
    "db:whoami:prod": "dotenv -e .env.production -- npx tsx scripts/db-whoami.ts",

    "db:deploy:testing": "dotenv -e .env.testing -- prisma migrate deploy",
    "db:deploy:academic": "dotenv -e .env.academic -- prisma migrate deploy",
    "db:deploy:prod": "dotenv -e .env.production -- prisma migrate deploy",

    "db:seed:academic": "dotenv -e .env.academic -- npx tsx prisma/seed.ts",
    "db:studio:academic": "dotenv -e .env.academic -- prisma studio",

    "db:backup:testing": "dotenv -e .env.testing -- npx tsx scripts/backup-db.ts",
    "db:backup:academic": "dotenv -e .env.academic -- npx tsx scripts/backup-db.ts",
    "db:backup:prod": "dotenv -e .env.production -- npx tsx scripts/backup-db.ts"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@types/qrcode": "^1.5.6",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "iron-session": "^8.0.4",
    "jspdf": "^2.5.2",
    "lucide-react": "^0.563.0",
    "next": "16.1.5",
    "prisma": "^6.19.2",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "redsys-easy": "^5.3.2",
    "tailwind-merge": "^3.4.0",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.5",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
}
