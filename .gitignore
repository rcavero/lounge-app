# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# database
prisma/*.db
prisma/*.db-journal
prisma/*.db.backup*

# claude code
.claude/

# windows temp
nul

# snapshot de trabajo de scripts/sync-verify.ts
scripts/.sync-snapshot.json

# volcados de datos reales: llevan datos personales de clientes
# Volcados de base de datos. Llevan datos personales de clientes reales (nombre,
# email, telefono) y hashes bcrypt de usuarios admin: NUNCA se commitean.
# Se ignora la carpeta entera por extension, no solo *.json: un pg_dump se llama
# .dump y con la regla antigua se habria colado en un commit.
backups/*
