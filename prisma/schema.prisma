// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Equipos deportivos
model Team {
  id         String   @id @default(cuid())
  externalId Int?     @unique // ID del proveedor externo (ESPN)
  name       String
  shortName  String
  league     String   // La Liga, Premier League, Serie A, Bundesliga, Ligue 1
  logo       String?  // Lo que pinta la UI: ruta local /escudos/{id}.png, o URL remota si aún no se ha descargado
  logoSource String?  // URL remota de origen (ESPN). Permite volver a descargar el escudo
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  homeEvents Event[] @relation("HomeTeam")
  awayEvents Event[] @relation("AwayTeam")
}

// Eventos deportivos (partidos)
model Event {
  id          String      @id @default(cuid())
  title       String
  description String?
  sport       String      @default("football") // football, basketball, etc.
  competition String?     // La Liga, Champions League, etc.
  externalMatchId Int?    @unique // ID del partido en el proveedor externo; evita eventos duplicados

  homeTeamId   String?
  homeTeam     Team?       @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeamId   String?
  awayTeam     Team?       @relation("AwayTeam", fields: [awayTeamId], references: [id])
  homeTeamName String?     // Nombre libre para deportes manuales (sin equipo en BD)
  awayTeamName String?     // Null para motor sports (solo un participante)

  eventDate    DateTime
  status       EventStatus @default(UPCOMING)
  // Pantallas donde se emite, separadas por comas: "TV1,TV2,TV3".
  // El @default sigue diciendo PROYECTOR a propósito: no lo usa nadie —los tres caminos
  // de creación (createEvent, updateEvent, createEventFromSuggestion) escriben `screens`
  // siempre— y cambiarlo obligaría a una migración a cambio de nada.
  screens      String      @default("PROYECTOR")
  pricePerSeat    Int         @default(10) // Precio por asiento en euros
  durationMinutes Int         @default(120) // Duración estimada en minutos

  // Gastos de gestión por asiento, en céntimos. No son descontables en consumiciones.
  // Solo admite los valores de MANAGEMENT_FEE_OPTIONS_CENTS: 0–500 en pasos de 50.
  managementFeeCents Int      @default(150)

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  reservations Reservation[]
  seatStatuses SeatStatus[]
}

enum EventStatus {
  UPCOMING
  LIVE
  FINISHED
  CANCELLED
}

// Definición de asientos del bar (estático)
model Seat {
  id       String   @id @default(cuid())

  // Nombre del asiento tal y como se lee en el local, y lo único que ve el cliente:
  // se imprime en el ticket PDF y en las tarjetas de reserva. Formato "A7.2", "M3.1".
  // Reglas: máx. 10 caracteres (ancho del ticket de 80 mm), sólo [A-Za-z0-9_-/.],
  // y único ignorando mayúsculas. Se cambia con scripts/rename-seats.ts.
  code     String   @unique

  // Vestigiales desde el renombrado a la nomenclatura del local: el nombre ya no
  // codifica zona ni fila. Se conservan porque son NOT NULL y porque cambiarlas
  // no aportaría nada; no las lee ningún camino vivo.
  zone     SeatZone
  row      String?
  number   Int

  // Posición en el mapa (para renderizado visual)
  posX     Int
  posY     Int

  capacity Int      @default(1) // Normalmente 1, pero puede ser mesa para grupos

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  seatStatuses SeatStatus[]
}

enum SeatZone {
  PROJECTOR // Zona del proyector principal
  TV1       // Zona TV 1
  TV2       // Zona TV 2
}

// Estado de asiento por evento (disponibilidad)
model SeatStatus {
  id        String           @id @default(cuid())

  eventId   String
  event     Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)

  seatId    String
  seat      Seat             @relation(fields: [seatId], references: [id], onDelete: Cascade)

  status    SeatStatusType   @default(AVAILABLE)

  reservationId String?
  reservation   Reservation? @relation(fields: [reservationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, seatId])
}

enum SeatStatusType {
  AVAILABLE
  RESERVED
  OCCUPIED
  BLOCKED
}

// Reservas
model Reservation {
  id              String            @id @default(cuid())

  eventId         String
  event           Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // Datos del cliente
  customerName    String
  customerEmail   String
  customerPhone   String?

  // Detalles de la reserva
  numberOfSeats   Int
  totalPrice      Decimal

  // Importes unitarios congelados en el momento del pago, en céntimos. Se guardan aquí
  // (y no se releen del evento) para que editar el evento más tarde no reescriba el
  // desglose de una reserva ya cobrada. Sin @default a propósito: así el cliente Prisma
  // obliga a rellenarlos en cada create y no puede existir una reserva sin desglose.
  // Invariante: totalPrice * 100 = (seatPriceCents + managementFeeCents) * numberOfSeats
  seatPriceCents     Int
  managementFeeCents Int

  status          ReservationStatus @default(PENDING)

  // Pago
  paymentId       String?           // ID de transacción Redsys
  paymentStatus   PaymentStatus     @default(PENDING)

  // Llave aleatoria de las páginas de vuelta del pago (RCA-285). El nº de pedido sale
  // del reloj y se adivina; esta viaja solo en las URL de vuelta que se firman para
  // Redsys, así que únicamente la tiene quien compró. NULL en las reservas anteriores:
  // esas se siguen abriendo solo con el nº de pedido, porque sus URL ya están repartidas.
  accessToken     String?

  // Recibo de pago: lo exige CaixaBank en la URL OK. Se guardan tal cual los manda
  // Redsys y solo desde una notificación con la firma ya verificada, así que son
  // NULL en las reservas anteriores y allí donde el webhook no llega (local, testing).
  authorisationCode   String?       // Ds_AuthorisationCode
  paymentDateTime     String?       // Ds_Date + Ds_Hour: "28/08/2026 21:34"
  paymentResponseCode String?       // Ds_Response: "0000".."0099" = autorizada

  // Timestamps
  confirmedAt     DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  seatStatuses    SeatStatus[]
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

// Usuarios administradores
model AdminUser {
  id        String    @id @default(cuid())
  email     String    @unique
  password  String    // bcrypt hash
  name      String    @default("")
  role      AdminRole @default(WORKER)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

enum AdminRole {
  ADMIN
  WORKER
}

// Configuración de etiquetas de zona en el mapa
model ZoneLabel {
  id       String @id @default(cuid())
  zone     String @unique // "TV1", "TV2", "PROYECTOR"
  posX     Float  // Posición X en porcentaje (0-100)
  posY     Float  // Posición Y en porcentaje (0-100)
  scaleX   Float  @default(1) // Escala horizontal
  rotation Float  @default(0) // Rotación en grados

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
